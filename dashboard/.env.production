# Production build settings.
#
# Vite INLINES these at build time - they are compiled into the JS bundle, not
# read at runtime. Whatever VITE_API_BASE_URL is set to when `npm run build`
# runs is the URL the deployed site will call forever. Rebuild to change it.

# Production API.
#
# alphaapi.quicko.rw DOES send access-control-allow-origin for
# https://dashboard.quicko.rw, so cross-origin requests are allowed - unlike
# the older tickets.quicko.rw host.
#
# CAVEAT: its access-control-allow-methods is still GET,HEAD,POST, so every
# PATCH / PUT / DELETE is blocked by the browser. Until that is fixed, the
# dashboard can read but not write cross-origin. See docs/deployment.md.
#
# If the deployment proxies /api itself, prefer `same-origin` instead: it
# avoids CORS entirely and needs no backend change.
VITE_API_BASE_URL=https://alphaapi.quicko.rw

# The dev proxy only exists in `vite dev`; a production build never uses it.
VITE_USE_DEV_PROXY=false
