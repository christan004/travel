# Production build settings.
#
# Vite INLINES these at build time - they are compiled into the JS bundle, not
# read at runtime. Whatever VITE_API_BASE_URL is set to when `npm run build`
# runs is the URL the deployed site will call forever. Rebuild to change it.
#
# This file exists so a production build cannot accidentally pick up a
# developer's local value (a build with localhost baked in makes the live site
# call the visitor's own machine).

VITE_API_BASE_URL=https://tickets.quicko.rw

# The dev proxy only exists in `vite dev`; a production build must talk to the
# API directly.
VITE_USE_DEV_PROXY=false
