# Production build settings.
#
# Vite INLINES these at build time - they are compiled into the JS bundle, not
# read at runtime. Whatever VITE_API_BASE_URL is set to when `npm run build`
# runs is the URL the deployed site will call forever. Rebuild to change it.

# dashboard.quicko.rw proxies /api to the API itself, so requests stay
# same-origin and no CORS headers are needed. Verified: a POST to
# https://dashboard.quicko.rw/api/v1/auth/login returns 200 and sets cookies.
#
# Use an absolute URL here ONLY if the deployment does not proxy /api - and
# note the API does not currently send access-control-allow-origin, so a
# cross-origin build will be blocked by the browser. See docs/deployment.md.
VITE_API_BASE_URL=same-origin

# The dev proxy only exists in `vite dev`; a production build never uses it.
VITE_USE_DEV_PROXY=false
