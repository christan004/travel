# Base URL of the SwiftBus Fastify API (no trailing slash).
VITE_API_BASE_URL=https://alphaapi.quicko.rw


# Route API calls through the Vite dev proxy (development only).
# The API currently returns no access-control-allow-origin header and its
# preflight allows only GET,HEAD,POST - so direct browser calls fail.
# Proxying makes requests same-origin and sidesteps CORS.
# Set to false once the backend sends correct CORS headers.
VITE_USE_DEV_PROXY=true
